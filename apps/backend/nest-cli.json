{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "correo/templates/**/*",
        "watchAssets": true
      },
      {
        "include": "resources/backgrounds/**/*",
        "watchAssets": true
      },
      {
        "include": "resources/fonts/**/*",
        "watchAssets": true
      }
    ]
  }
}
