# Puertos publicados en el equipo anfitrión
FRONTEND_PORT=9000
BACKEND_PORT=3000
POSTGRES_EXPOSE_PORT=5432

# PostgreSQL
POSTGRES_DB=sistema_congreso
POSTGRES_USER=congreso_user
POSTGRES_PASSWORD=cambiar_por_una_contrasena_segura

# URLs públicas utilizadas en enlaces, redirecciones y CORS
FRONTEND_URL=http://localhost:9000
BACKEND_URL=http://localhost:3000
QR_ACCESS_BASE_URL=http://localhost:9000/acceso/qr
VITE_API_URL=/api/

# Zona horaria y tareas automáticas
CONGRESS_TIMEZONE=America/Mexico_City
RECONOCIMIENTOS_JOB_ENABLED=true
RECONOCIMIENTOS_CRON=*/5 * * * *
RECONOCIMIENTOS_TIMEZONE=America/Mexico_City

# Correo SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=usuario_smtp
MAIL_PASS=cambiar_por_la_contrasena_smtp
MAIL_FROM=Congreso UTVM <no-reply@example.com>

# Firma de tokens de verificación
EMAIL_VERIFICATION_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# Supabase Storage
SUPABASE_URL=https://tu-proyecto.supabase.co
